<mjml>
  <mj-head>
    <mj-include path="./_theme.mjml" />
    <mj-title>Registration forms outstanding</mj-title>
    <mj-preview><%= dueSoon.length %> due within <%= withinDays %> days, <%= chased.length %> chased and still waiting</mj-preview>
  </mj-head>
  <mj-body background-color="#eef0f4" width="600px">
    <mj-include path="./_header.mjml" />

    <mj-section padding="28px 0 0">
      <mj-column>
        <mj-text mj-class="h1">Registration forms outstanding</mj-text>
        <mj-text mj-class="lede" padding="10px 24px 0">
          <%= received %> of <%= total %> clubs have sent their team registration form in
          for <%= seasonLabel %>. Here is what is still open.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Each block is guarded, and every guard is inside mj-raw. An EJS tag sitting
         directly between two MJML components is discarded by the compiler and the content
         it was meant to guard renders unconditionally, with no error — so an empty
         "chased" list would print a stray heading over nothing. tools/build-emails.js
         counts the tags either side of the build to keep that honest. -->
    <mj-raw><% if (dueSoon.length) { %></mj-raw>
    <mj-section padding="22px 24px 0">
      <mj-column background-color="#f4f6f9" padding="18px 20px" border-radius="6px">
        <mj-text mj-class="label" text-transform="uppercase" padding="0">
          Due within <%= withinDays %> days
        </mj-text>
        <mj-table padding="10px 0 0" font-size="14px" color="#22303f" cellpadding="0">
          <% for (const club of dueSoon) { %>
          <tr>
            <td style="padding:6px 10px 6px 0;font-weight:bold;"><%= club.name %></td>
            <td style="padding:6px 10px 6px 0;color:#68758a;white-space:nowrap;"><%= club.firstFixtureLabel %></td>
            <td style="padding:6px 0;white-space:nowrap;color:<%= club.daysAway < 0 ? '#b3261e' : '#68758a' %>;">
              <%= club.dueLabel %><%= club.chaseCount ? ' · chased ' + club.chaseCount + '×' : '' %>
            </td>
          </tr>
          <% } %>
        </mj-table>
      </mj-column>
    </mj-section>
    <mj-raw><% } %></mj-raw>

    <mj-raw><% if (chased.length) { %></mj-raw>
    <mj-section padding="14px 24px 0">
      <mj-column background-color="#f4f6f9" padding="18px 20px" border-radius="6px">
        <mj-text mj-class="label" text-transform="uppercase" padding="0">
          Chased already, still nothing back
        </mj-text>
        <mj-table padding="10px 0 0" font-size="14px" color="#22303f" cellpadding="0">
          <% for (const club of chased) { %>
          <tr>
            <td style="padding:6px 10px 6px 0;font-weight:bold;"><%= club.name %></td>
            <td style="padding:6px 10px 6px 0;color:#68758a;white-space:nowrap;"><%= club.firstFixtureLabel %></td>
            <td style="padding:6px 0;white-space:nowrap;color:#68758a;">
              chased <%= club.chaseCount %>&times;, last <%= club.chasedLabel %>
            </td>
          </tr>
          <% } %>
        </mj-table>
      </mj-column>
    </mj-section>
    <mj-raw><% } %></mj-raw>

    <mj-section>
      <mj-column>
        <mj-button href="<%= worklistUrl %>" css-class="cta">Open the worklist</mj-button>
        <mj-text mj-class="muted" align="center" padding="14px 24px 0">
          From there you can send a club its pre-filled form, or tick one off as received.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section><mj-column><mj-divider /></mj-column></mj-section>

    <mj-section padding="0 0 26px">
      <mj-column>
        <mj-text mj-class="muted">
          If a link does not work, paste this into your browser:<br />
          <span class="breakable"><%= worklistUrl %></span>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="./_footer.mjml" />
  </mj-body>
</mjml>
