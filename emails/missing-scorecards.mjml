<mjml>
  <mj-head>
    <mj-include path="./_theme.mjml" />
    <mj-title>Missing scorecards</mj-title>
    <mj-preview><%= fixtures.length %> fixture(s) with no scorecard</mj-preview>
  </mj-head>
  <mj-body background-color="#eef0f4" width="600px">
    <mj-include path="./_header.mjml" />

    <mj-section padding="28px 0 0">
      <mj-column>
        <mj-text mj-class="h1"><%= fixtures.length %> missing scorecard<%= fixtures.length === 1 ? '' : 's' %></mj-text>
        <mj-text mj-class="lede" padding="10px 24px 0">
          Played <%= daysAgo %> days ago, and nothing has been entered or submitted yet.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="22px 24px 0">
      <mj-column background-color="#f4f6f9" padding="18px 20px" border-radius="6px">
        <mj-table padding="0" font-size="14px" color="#22303f" cellpadding="0">
          <% for (const f of fixtures) { %>
          <tr>
            <td style="padding:6px 10px 6px 0;color:#68758a;white-space:nowrap;"><%= f.date %></td>
            <td style="padding:6px 0;font-weight:bold;"><%= f.homeTeam %> v <%= f.awayTeam %></td>
          </tr>
          <% } %>
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-include path="./_footer.mjml" />
  </mj-body>
</mjml>
