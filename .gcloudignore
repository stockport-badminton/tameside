# Files *not* uploaded when `gcloud builds submit` tarballs this directory.
# Same syntax as .gitignore, plus "#!include" directives.
#   $ gcloud topic gcloudignore
#
# This only affects the manual submit path — trigger builds fetch straight from
# GitHub, so for those the build context is whatever is committed.
#
# Everything the image itself doesn't need is already listed in .dockerignore, so
# include that rather than maintaining a second copy that can drift out of sync.
# Only the entries that are specific to uploading live here.

.gcloudignore
.git
.gitignore

#!include:.dockerignore
