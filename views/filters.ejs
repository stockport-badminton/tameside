<!-- Filter toolbar. One compact row of selects that reload the page on Apply,
     followed by a chip per applied filter linking to the same page without it.
     Which selects appear is controlled by the `hideFilters` array the controller
     passes; `clubs` / `teams` supply their own options.

     Division and season options come from the DB via res.locals.filterBar
     (middleware/filterState.js) - they used to be hardcoded here and the season
     list had gone two seasons stale. filterBar.active is also what pre-selects
     each option, so the toolbar shows the filters that are actually applied.

     The table's own controls (columns, page size, search) are rendered by
     DataTables into the band directly above the table - see datatables-stats.ejs. -->
<%
  const hidden = (typeof hideFilters !== 'undefined' && hideFilters) ? hideFilters : [];
  const applied = filterBar.active;
%>
<div class="filter-toolbar">
  <form action="" id="statsFilter" class="filter-toolbar-form">
    <div class="filter-fields">

      <% if (hidden.indexOf('division') === -1) { %>
        <div class="filter-field">
          <label for="divisionSelect"><i class="fas fa-trophy"></i> Division</label>
          <select class="form-control" name="divisionSelect" id="divisionSelect">
            <option value="0">All divisions</option>
            <% for (const division of filterBar.divisions) { %>
              <option value="<%= division.value %>" <%= applied.division === division.value ? 'selected' : '' %>><%= division.name %></option>
            <% } %>
          </select>
        </div>
      <% } %>

      <% if (hidden.indexOf('season') === -1) { %>
        <div class="filter-field">
          <label for="seasonSelect"><i class="fas fa-calendar-check"></i> Season</label>
          <select class="form-control" name="seasonSelect" id="seasonSelect">
            <option value="0">Current season<%= filterBar.currentSeasonLabel ? ' (' + filterBar.currentSeasonLabel + ')' : '' %></option>
            <% for (const season of filterBar.seasons) { %>
              <option value="<%= season.value %>" <%= applied.season === season.value ? 'selected' : '' %>><%= season.label %></option>
            <% } %>
          </select>
        </div>
      <% } %>

      <% if (hidden.indexOf('status') === -1) { %>
        <div class="filter-field">
          <label for="statusSelect"><i class="fas fa-circle-check"></i> Status</label>
          <select class="form-control" name="statusSelect" id="statusSelect">
            <option value="0">All statuses</option>
            <% for (const status of ['outstanding', 'rearranging', 'rearranged', 'conceded', 'complete']) { %>
              <option value="<%= status %>" <%= applied.status === status ? 'selected' : '' %>><%= status.charAt(0).toUpperCase() + status.slice(1) %></option>
            <% } %>
          </select>
        </div>
      <% } %>

      <% if (hidden.indexOf('gender') === -1) { %>
        <div class="filter-field">
          <label for="gender"><i class="fas fa-venus-mars"></i> Gender</label>
          <select class="form-control" name="gender" id="gender">
            <option value="0">All</option>
            <option value="Male" <%= applied.gender === 'Male' ? 'selected' : '' %>>Male</option>
            <option value="Female" <%= applied.gender === 'Female' ? 'selected' : '' %>>Female</option>
          </select>
        </div>
      <% } %>

      <% if (hidden.indexOf('gametype') === -1) { %>
        <div class="filter-field">
          <label for="gameType"><i class="fas fa-shuttle-badminton"></i> Game type</label>
          <select class="form-control" name="gameType" id="gameType">
            <option value="0">All types</option>
            <% for (const type of ['Mens', 'Ladies', 'Mixed']) { %>
              <option value="<%= type %>" <%= applied.gameType === type ? 'selected' : '' %>><%= type %></option>
            <% } %>
          </select>
        </div>
      <% } %>

      <% if (typeof clubs !== 'undefined') { %>
        <div class="filter-field">
          <label for="club"><i class="fas fa-building"></i> Club</label>
          <select class="form-control" name="club" id="club">
            <option value="0">All clubs</option>
            <% for (const row of clubs) { %>
              <option value="<%= row %>" <%= applied.club === String(row) ? 'selected' : '' %>><%= row %></option>
            <% } %>
          </select>
        </div>
      <% } %>

      <% if (typeof teams !== 'undefined') { %>
        <div class="filter-field">
          <label for="team"><i class="fas fa-users"></i> Team</label>
          <select class="form-control" name="team" id="team">
            <option value="0">All teams</option>
            <% for (const row of teams) { %>
              <option value="<%= row %>" <%= applied.team === String(row) ? 'selected' : '' %>><%= row %></option>
            <% } %>
          </select>
        </div>
      <% } %>

    </div>

    <button class="btn-modern-primary filter-apply" id="statsUpdate" type="button">
      <i class="fas fa-filter"></i> Apply filters
    </button>
  </form>

  <% if (filterBar.chips.length) { %>
    <div class="filter-chips">
      <span class="filter-chips-label">Showing</span>
      <% for (const chip of filterBar.chips) { %>
        <a class="filter-chip" href="<%= chip.removeUrl %>" title="<%= chip.title %>">
          <%= chip.label %><i class="fas fa-xmark"></i>
        </a>
      <% } %>
      <a class="filter-clear" href="<%= filterBar.clearUrl %>">Clear all</a>
    </div>
  <% } %>
</div>
