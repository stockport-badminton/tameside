<%- include('../header.ejs') %>
<%- include('../nav.ejs') %>

<%# Which player each login is (controllers/authLinkController.js). Every account that
    can log in, including the Stockport ones the shared Auth0 tenant lets in here.
    Linking says who a login is and never grants a role. %>
<%
  // One row's "link to a player" cell: the contact-address match, name hints, and a search.
  function linkCell(entry) { %>
    <% if (entry.contactMatch) { %>
      <form method="post" action="/admin/link-auth-accounts" class="mb-1">
        <input type="hidden" name="userId" value="<%= entry.userId %>">
        <input type="hidden" name="playerId" value="<%= entry.contactMatch.id %>">
        <button type="submit" class="btn btn-sm btn-success">Link to <%= entry.contactMatch.name %></button>
        <span class="small text-muted">
          <%= entry.contactMatch.club %><%= entry.contactMatch.team ? ' / ' + entry.contactMatch.team : '' %>
          <span class="badge bg-success">contact address matches</span>
        </span>
      </form>
    <% } %>
    <% (entry.hints || []).forEach(function (h) { %>
      <form method="post" action="/admin/link-auth-accounts" class="mb-1">
        <input type="hidden" name="userId" value="<%= entry.userId %>">
        <input type="hidden" name="playerId" value="<%= h.id %>">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Link to <%= h.name %></button>
        <span class="small text-muted">
          <%= h.club || 'no club' %><%= h.team ? ' / ' + h.team : '' %>
          <%= h.exact ? '' : '(close name)' %>
          <% if (h.parked) { %>
            <span class="badge bg-warning text-dark" title="Parked rows include ~200 copied from Stockport's database when this site was built">parked</span>
          <% } %>
        </span>
      </form>
    <% }); %>
    <form method="post" action="/admin/link-auth-accounts" class="link-form" style="position:relative;">
      <input type="hidden" name="userId" value="<%= entry.userId %>">
      <input type="hidden" name="playerId" class="player-id">
      <div class="input-group input-group-sm">
        <input type="text" class="form-control player-search" placeholder="search for a player…" autocomplete="off">
        <button type="submit" class="btn btn-sm btn-primary link-submit" disabled>Link</button>
      </div>
      <div class="list-group search-results"
           style="display:none; position:absolute; z-index:20; width:100%; max-height:240px; overflow-y:auto;"></div>
      <div class="small mt-1 selected-label text-success" style="display:none;"></div>
    </form>
<% }

  function accountCell(entry) { %>
    <code><%= entry.email %></code>
    <% if (entry.name) { %><br><span class="small"><%= entry.name %></span><% } %>
    <% if (entry.claimClub || entry.signedUpOn) { %>
      <br><span class="small text-muted">
        <%= entry.claimClub ? 'old claim: ' + entry.claimClub : '' %>
        <%= entry.signedUpOn ? 'signed up on ' + entry.signedUpOn : '' %>
      </span>
    <% } %>
<% }

  function worklistTable(entries) { %>
    <div class="table-responsive">
      <table class="table table-sm align-middle">
        <thead>
          <tr><th>Login</th><th>Activity</th><th style="min-width: 320px;">Link to player</th></tr>
        </thead>
        <tbody>
          <% entries.forEach(function (entry) { %>
            <tr>
              <td><% accountCell(entry) %></td>
              <td class="text-muted small"><%= entry.logins %> logins<br>last <%= entry.lastLogin || 'never' %></td>
              <td><% linkCell(entry) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
<% } %>

<div class="container my-4">
  <div class="d-flex justify-content-between align-items-baseline flex-wrap">
    <h5 class="mb-1">Link logins to players</h5>
    <span class="small text-muted">
      Auth0 is shared with the Stockport site, so their approved players can log in here too.
      <a href="/admin/link-auth-accounts?refresh=1">Refresh from Auth0</a>
    </span>
  </div>
  <p class="small text-muted mb-2">
    A linked login sees its own club's stats. Linking never grants a role: that is on the
    player's edit page. Changes take effect at the person's next login.
  </p>

  <div id="worklist" style="scroll-margin-top: 0.5rem;">
    <strong><%= data.linked.length + data.emailOnly.length %> of <%= data.canLogIn %> logins linked</strong>
    <% if (flash) { %>
      <div class="alert alert-success py-1 px-2 my-2 small" role="status"><%= flash %></div>
    <% } %>
  </div>

  <% if (data.emailOnly.length) { %>
    <div class="alert alert-info small mt-2">
      <strong><%= data.emailOnly.length %></strong> logins are linked by address only (by the
      approve page or the August move). Recording their account ids is what lets the login
      find them. Nothing about who they are changes.
      <form method="post" action="/admin/link-auth-accounts/record-email-links" class="d-inline">
        <button type="submit" class="btn btn-sm btn-primary ms-2">Record <%= data.emailOnly.length %> account links</button>
      </form>
    </div>
  <% } %>

  <h6 class="text-muted mt-3">Needs a player (<%= data.needsPlayer.length %>)</h6>
  <% if (data.needsPlayer.length) { worklistTable(data.needsPlayer) } else { %>
    <p class="small text-success">Nothing left.</p>
  <% } %>

  <details class="mt-3">
    <summary><strong>Probably Stockport's (<%= data.otherLeague.length %>)</strong></summary>
    <p class="small text-muted mt-2">
      Their old Auth0 club claim names a club we don't have, or they signed up on Stockport's
      site. Leave them unlinked unless they also play here.
    </p>
    <% if (data.otherLeague.length) worklistTable(data.otherLeague) %>
  </details>

  <div id="cull" class="mt-4" style="scroll-margin-top: 0.5rem;">
    <h6 class="text-muted">Login cull</h6>
    <% if (!cull) { %>
      <p class="small text-danger">Could not build the cull list: <%= cullError %></p>
    <% } else { %>
      <p class="small text-muted mb-2">
        Once a month, our logins (linked to a player here, or signed up on this site) that have
        gone a year without being used get an email. Logging in to either site, or the link in
        the email, keeps them. A month after the email they are listed here.
        <% if (cull.notify.length) { %>
          <strong><%= cull.notify.length %></strong> will get the email at the next run.
        <% } %>
      </p>

      <% if (cull.due.length) { %>
        <form method="post" action="/admin/link-auth-accounts/delete-due">
          <div class="table-responsive">
            <table class="table table-sm align-middle">
              <thead><tr><th>Due for deletion (<%= cull.due.length %>)</th><th>Player</th><th>Last used</th><th>Why</th><th></th></tr></thead>
              <tbody>
                <% cull.due.forEach(function (e) { %>
                  <tr>
                    <td><code><%= e.user.email || e.user.user_id %></code>
                      <input type="hidden" name="userId" value="<%= e.user.user_id %>"></td>
                    <td><%= e.player ? (e.player.first_name + ' ' + e.player.family_name) : '—' %>
                      <span class="small text-muted"><%= e.player ? (e.player.clubName || '') + (e.player.role ? ', ' + e.player.role : '') : '' %></span></td>
                    <td class="small"><%= e.lastActive %></td>
                    <td class="small text-muted"><%= e.reason %><%= e.notified ? ' (emailed ' + e.notified + ')' : '' %></td>
                    <td><button type="submit" class="btn btn-link btn-sm p-0" form="keep-<%= e.user.user_id %>">keep</button></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <button type="submit" class="btn btn-sm btn-danger"
                  onclick="return confirm('Delete <%= cull.due.length %> login(s) from Auth0? They are gone from Stockport\'s site too.')">
            Delete <%= cull.due.length %> <%= cull.due.length === 1 ? 'login' : 'logins' %>
          </button>
          <span class="small text-muted ms-2">From Auth0, which Stockport's site shares, and their link to a player here. Results are untouched.</span>
        </form>
        <% cull.due.forEach(function (e) { %>
          <form id="keep-<%= e.user.user_id %>" method="post" action="/admin/link-auth-accounts/keep">
            <input type="hidden" name="userId" value="<%= e.user.user_id %>">
          </form>
        <% }); %>
      <% } else { %>
        <p class="small text-success">Nothing due for deletion.</p>
      <% } %>

      <% if (cull.waiting.length) { %>
        <details class="mt-2">
          <summary><strong>Emailed, waiting (<%= cull.waiting.length %>)</strong></summary>
          <ul class="small mt-2">
            <% cull.waiting.forEach(function (e) { %>
              <li><code><%= e.user.email %></code>
                <%= e.player ? '→ ' + e.player.first_name + ' ' + e.player.family_name : '' %>,
                emailed <%= e.notified %>, listed here from <%= e.expires %></li>
            <% }); %>
          </ul>
        </details>
      <% } %>
    <% } %>
  </div>

  <details class="mt-3">
    <summary><strong>Unlinked, no login in <%= staleYears %> years (<%= data.stale.length %>)</strong></summary>
    <p class="small text-muted mt-2">
      Not linked to anyone here, so not ours to cull unless they signed up on this site (those
      are in the cull above). Stockport's monthly cull covers the rest. Link one if it's ours.
    </p>
    <% if (data.stale.length) worklistTable(data.stale) %>
  </details>

  <details class="mt-3">
    <summary><strong>Linked (<%= data.linked.length + data.emailOnly.length %>)</strong></summary>
    <ul class="small mt-2">
      <% data.linked.concat(data.emailOnly).forEach(function (entry) { %>
        <li>
          <code><%= entry.email %></code> &rarr; <%= entry.linked.name %>
          (<%= entry.linked.club || 'no club' %>)<%= entry.linked.role ? ', ' + entry.linked.role : '' %>
          <% if (entry.linked.via === 'email') { %><span class="badge bg-info">by address</span><% } %>
          <form method="post" action="/admin/link-auth-accounts/unlink" class="d-inline">
            <input type="hidden" name="userId" value="<%= entry.userId %>">
            <button type="submit" class="btn btn-link btn-sm p-0 ms-1">unlink</button>
          </form>
        </li>
      <% }); %>
    </ul>
  </details>
</div>

<script>
  // Per-row player search. One delegated set of handlers rather than one closure per row.
  (function () {
    var timers = new WeakMap();

    // textContent everywhere: player names are user-entered.
    function render(form, players) {
      var box = form.querySelector('.search-results');
      box.textContent = '';
      if (!players.length) { box.style.display = 'none'; return; }

      players.slice(0, 8).forEach(function (p) {
        var item = document.createElement('a');
        item.href = '#';
        item.className = 'list-group-item list-group-item-action py-1 small';

        var name = document.createElement('strong');
        name.textContent = p.name;
        item.appendChild(name);

        var meta = document.createElement('span');
        meta.className = 'text-muted';
        meta.textContent = p.teamName ? ' — ' + p.teamName : '';
        item.appendChild(meta);

        item.addEventListener('click', function (e) {
          e.preventDefault();
          form.querySelector('.player-id').value = p.id;
          var label = form.querySelector('.selected-label');
          label.textContent = 'Selected: ' + p.name + (p.teamName ? ' (' + p.teamName + ')' : '');
          label.style.display = 'block';
          form.querySelector('.link-submit').disabled = false;
          form.querySelector('.player-search').value = '';
          box.style.display = 'none';
        });

        box.appendChild(item);
      });
      box.style.display = 'block';
    }

    document.addEventListener('input', function (e) {
      var input = e.target.closest('.player-search');
      if (!input) return;
      var form = input.closest('.link-form');

      clearTimeout(timers.get(input));
      timers.set(input, setTimeout(function () {
        var q = input.value.trim();
        if (q.length < 2) {
          form.querySelector('.search-results').style.display = 'none';
          return;
        }
        fetch('/api/players/search?q=' + encodeURIComponent(q))
          .then(function (r) { return r.json(); })
          .then(function (players) { render(form, players); })
          .catch(function () { form.querySelector('.search-results').style.display = 'none'; });
      }, 250));
    });

    // A row whose hidden playerId was never filled must not submit: the button starts
    // disabled, but Enter in the text field would otherwise bypass that.
    document.addEventListener('submit', function (e) {
      var form = e.target.closest('.link-form');
      if (form && !form.querySelector('.player-id').value) {
        e.preventDefault();
      }
    });
  })();
</script>

<%- include('../footer.ejs') %>
