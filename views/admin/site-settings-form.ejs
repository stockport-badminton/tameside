<%- include('../header.ejs') %>
<%- include('../nav.ejs') %>

<%
  var galleryTag = '';
  var promotionPlaces = '2';
  settings.forEach(function(s){
    if (s.key === 'homepage_gallery_tag') galleryTag = s.value;
    if (s.key === 'promotion_places') promotionPlaces = s.value;
  });
%>

<div class="col-12">
  <h1>Site Settings</h1>
  <p><a href="/admin/homepage-content">Homepage Content</a></p>

  <form method="post" action="/admin/site-settings">
    <div class="mb-3">
      <label class="form-label" for="homepage_gallery_tag">Gallery Cloudinary Tag</label>
      <input type="text" class="form-control" id="homepage_gallery_tag" name="homepage_gallery_tag" value="<%= galleryTag %>">
      <small class="form-text text-muted">The Cloudinary asset tag used to fetch homepage gallery photos (e.g. "messer2024"). Note: the gallery is not currently displayed on the site — this is reserved for a future gallery feature.</small>
    </div>
    <div class="mb-3">
      <label class="form-label" for="promotion_places">Teams up and down</label>
      <input type="number" min="0" max="4" step="1" class="form-control" style="max-width: 8em" id="promotion_places" name="promotion_places" value="<%= promotionPlaces %>">
      <small class="form-text text-muted">How many teams go up from Division 2 and down from Division 1 this season. Used by the League Run-in and the projected tables on Team Strength. Changes from season to season; 2 until it is set.</small>
    </div>
    <div class="mb-3">
      <label class="form-label" for="lewis_secretary">Lewis secretary</label>
      <select class="form-select" style="max-width: 28em" id="lewis_secretary" name="lewis_secretary">
        <option value="">(none: superadmins only)</option>
        <% candidates.forEach(function(p){ %>
          <option value="<%= p.id %>" <%= p.id === lewisSecretary ? 'selected' : '' %>><%= p.name %><%= p.club ? ' (' + p.club + ')' : '' %></option>
        <% }); %>
      </select>
      <small class="form-text text-muted">Sets the Lewis Shield handicaps at <a href="/lewis-shield/handicaps">/lewis-shield/handicaps</a>. Their login must be linked to this player (Link Logins). Takes effect straight away.</small>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
  </form>
</div>

<%- include('../footer.ejs') %>
