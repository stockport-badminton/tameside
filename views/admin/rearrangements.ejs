<%- include('../header.ejs', { useRosterCss: true }) %>
<%- include('../nav.ejs') %>

<%# Ported from Stockport's views/admin/rearrangements.ejs (Bootstrap 5 here). %>
<div class="roster-page text-start">

  <h1>Rearrangement requests</h1>

  <p class="text-muted">
    Mail to <strong><%= address %></strong> appears here, with the fixture and new date it
    points at ready to confirm. A captain or secretary can write to it directly, or you can
    forward an agreed rearrangement to it. Only a known sender whose address checks out is
    queued, the same rule as the list addresses. Nothing changes until you press Apply.
  </p>

  <ul class="nav nav-tabs mb-3">
    <% ['pending', 'done', 'dismissed'].forEach(function (s) { %>
      <li class="nav-item">
        <a class="nav-link <%= s === status ? 'active' : '' %>" href="/admin/rearrangements?status=<%= s %>"><%= s[0].toUpperCase() + s.slice(1) %></a>
      </li>
    <% }); %>
  </ul>

  <% if (!requests.length) { %>
    <p class="text-muted">Nothing <%= status %>.</p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-sm">
        <thead>
          <tr>
            <th>Received</th>
            <th>From</th>
            <th>Subject</th>
            <% if (status !== 'pending') { %><th>Outcome</th><th>Closed by</th><% } %>
          </tr>
        </thead>
        <tbody>
          <% requests.forEach(function (r) { %>
            <tr>
              <td class="text-nowrap"><%= new Date(r.receivedAt).toLocaleString('en-GB', { timeZone: 'Europe/London', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></td>
              <td style="word-break:break-all;"><%= r.originalFrom || r.forwardedBy %></td>
              <td><a href="/admin/rearrangements/<%= r.id %>"><%= r.subject || '(no subject)' %></a></td>
              <% if (status !== 'pending') { %>
                <td>
                  <% if (r.outcome && r.outcome.action === 'rearranged') { %>
                    Fixture <%= r.outcome.fixtureId %> moved to <%= r.outcome.date %>
                  <% } else if (r.outcome && r.outcome.action === 'rearranging') { %>
                    Fixture <%= r.outcome.fixtureId %> marked rearranging
                  <% } else { %>
                    <span class="text-muted">&mdash;</span>
                  <% } %>
                </td>
                <td><%= r.closedBy %></td>
              <% } %>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>

  <%- include('inbound-refused.ejs', { refused: refused, address: address }) %>

</div>

<%- include('../footer.ejs') %>
