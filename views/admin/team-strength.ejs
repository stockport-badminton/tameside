<%#
  Team strength: the latest nightly run (controllers/teamStrengthController.js). Superadmin
  only: every row names a player. The rating and how it was tested: docs/team-strength.md.
%>
<%- include('../header.ejs') %>
<%- include('../nav.ejs') %>
<%
  var MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  // By hand, in UK time, not toLocaleString: its output depends on the ICU data in Node.
  function when(d) {
    var parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', year: 'numeric', month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' })
      .formatToParts(new Date(d)).reduce(function (o, p) { o[p.type] = p.value; return o; }, {});
    return Number(parts.day) + ' ' + MONTHS[Number(parts.month) - 1] + ' ' + parts.year + ', ' + parts.hour + ':' + parts.minute;
  }
  function day(iso) {
    if (!iso) return '';
    var b = iso.split('-');
    return Number(b[2]) + ' ' + MONTHS[Number(b[1]) - 1] + ' ' + b[0];
  }
  function place(p) { return p.rank == null ? '–' : (p.rank >= 99 ? 'R' : String(p.rank)); }
%>

<div class="col-12">
  <h1>Team strength</h1>
  <p class="text-muted">
    A points-based rating for every player, fitted each night to every league game since
    September 2024: each rally counts, so a 21&ndash;15 game says more than a 21&ndash;19 one,
    and a game a year old counts half. 1500 is the centre of the scale; 100 points between two
    partners is about 63% of games. &plusmn; is one standard error, so a wide one means few
    recent games. Men and ladies are rated on separate scales. Lewis Shield games are not
    counted. &#9733; marks the four men and two ladies the team is expected to field: whoever
    has played most for it this season, then its nominated players.
  </p>

  <form method="post" action="/admin/team-strength/run" class="mb-3">
    <button type="submit" class="btn btn-outline-primary btn-sm">Run now</button>
    <% if (run) { %>
      <span class="text-muted ms-2">
        Last run <%= when(run.ran_at) %> (<%= run.caller %>): <%= run.games %> games in <%= (run.took_ms / 1000).toFixed(1) %>s.
      </span>
    <% } %>
  </form>

  <% if (!data) { %>
    <p>No run yet. Run it once to see the ratings.</p>
  <% } else { %>
    <p class="small text-muted">
      Home advantage: <%= data.home %> points per pair.
      Division averages:
      <% data.divisionMeans.forEach(function (d, i) { %><%= i ? '; ' : '' %>Division <%= d.rank %> men <%= d.men %>, ladies <%= d.ladies %><% }) %>.
    </p>

    <% var division = null; %>
    <% data.teams.forEach(function (t) { %>
      <% if (t.division !== division) { division = t.division; %>
        <h2 class="h4 mt-4"><%= division %></h2>
      <% } %>
      <h3 class="h6 mt-3"><%= t.name %> <span class="text-muted">(<%= t.club %>)</span></h3>
      <div class="row">
        <% [['Men', t.men, t.usual.men], ['Ladies', t.ladies, t.usual.ladies]].forEach(function (g) { %>
          <div class="col-lg-6">
            <div class="table-responsive">
              <table class="table table-sm align-middle mb-2">
                <thead>
                  <tr><th><%= g[0] %></th><th></th><th class="text-end">Rating</th><th class="text-end">Mixed</th><th class="text-end">Games (year)</th><th>Last game</th></tr>
                </thead>
                <tbody>
                  <% if (!g[1].length) { %><tr><td colspan="6" class="text-muted">None registered</td></tr><% } %>
                  <% g[1].forEach(function (p) { %>
                    <tr>
                      <td><%= place(p) %></td>
                      <td><%= p.name %><% if (g[2].indexOf(p.id) !== -1) { %> <span title="expected to play">&#9733;</span><% } %></td>
                      <td class="text-end"><% if (p.r == null) { %><span class="text-muted">no games</span><% } else { %><%= p.r %> <span class="text-muted small">&plusmn;<%= p.se %></span><% } %></td>
                      <td class="text-end"><%= p.r == null ? '' : (p.mixed > 0 ? '+' : '') + p.mixed %></td>
                      <td class="text-end"><%= p.games %> (<%= p.recent %>)</td>
                      <td><%= day(p.last) %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        <% }) %>
      </div>
    <% }) %>
  <% } %>
</div>

<%- include('../footer.ejs') %>
</body>
</html>
