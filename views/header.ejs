<!-- Webfonts used by modern-styles.css. Declared here rather than via @import inside
     the stylesheet: an @import can only start downloading after the importing sheet
     has been fetched and parsed, which serialises two round trips before any text
     can paint. -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Poppins:wght@600;700&display=swap">

<!-- Bootstrap + Font Awesome, compiled from bootstrap/style.scss. This already
     contains the full Font Awesome 6 CSS (icons, and @font-face pointing at
     /static/webfonts), so no CDN copy of Font Awesome is needed on top. -->
<link rel="stylesheet" href="<%= assetUrl('/static/css/style.css') %>" type="text/css" />

<!-- Modern Styles - MUST come after Bootstrap -->
<link rel="stylesheet" href="<%= assetUrl('/static/css/modern-styles.css') %>" type="text/css" />

<!-- DataTables styling, only on the handful of pages that build a DataTable.
     Those views opt in with include('header.ejs', { useDataTables: true }). -->
<% if (typeof useDataTables !== 'undefined' && useDataTables) { %>
<%- include('datatables-css.ejs') %>
<% } %>



    <% if (title == 'Local Badminton Club Information'){ 
      for (row of result ){ %>
        <script type="application/ld+json">
          {
            "@context": "http://schema.org/",
            "@type": "SportsClub",
            "name": "<%= row.name %> Badminton Club",
            "url": "<%= row.clubWebsite %>",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "<%= row.address %>",
              "addressLocality": "<%= row.address.match(/(Knutsford|Cheadle Hulme|Macclesfield|Cheadle Heath|East Didsbury|Manchester|Whalley Range|Wilmslow|Mellor|Disley)/g) %>",
              "addressRegion": "Cheshire",
              "postalCode": "<%= row.address.match(/([A-Z0-9]{3,4})\s([A-Z0-9]{3,4})/g) %>",
              "addressCountry": "GB"
            }
          }
          </script>

    <%  }

     } %>

     <% if (title.indexOf("Homepage") >= 0){ 

      for (fixtureDetails of row){
    
      
      var MyDate = new Date(fixtureDetails.date);
      var MyDateString;
    
      // MyDate.setDate(MyDate.getDate() + 20);
    
      MyDateString = ('0' + MyDate.getDate()).slice(-2) + '/'
                   + ('0' + (MyDate.getMonth()+1)).slice(-2) + '/'
                   + MyDate.getFullYear();
      let offset = (new Date(MyDate.getFullYear() + '-' + ('0' + (MyDate.getMonth()+1)).slice(-2) + '-' +('0' + MyDate.getDate()).slice(-2)).getTimezoneOffset())/60
      let DSTOffset = offset < 0 ? '+01:00' : ''
      OtherDateStringStartTime = MyDate.getFullYear() + '-' + ('0' + (MyDate.getMonth()+1)).slice(-2) + '-' +('0' + MyDate.getDate()).slice(-2) + 'T' + fixtureDetails.startTime + DSTOffset
      OtherDateStringEndTime = MyDate.getFullYear() + '-' + ('0' + (MyDate.getMonth()+1)).slice(-2) + '-' +('0' + MyDate.getDate()).slice(-2) + 'T' + fixtureDetails.endTime + DSTOffset
    %>
      
