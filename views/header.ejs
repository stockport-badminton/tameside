                "name":"<%= fixtureDetails.homeClub %>",
                "url":"<%= typeof fixtureDetails.clubWebsite !== 'undefined' ? fixtureDetails.clubWebsite : 'https://tameside-badminton.co.uk' %>"
              }
            }
          </script>
