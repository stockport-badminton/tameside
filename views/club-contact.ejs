<%- include('header.ejs') %>
<%- include('nav.ejs') %>

<% if (error || typeof clubrow == 'undefined') { %>
  <div class="container my-5">
    <div class="alert alert-danger" role="alert">
      <%- icon('triangle-exclamation') %> <strong>Something went wrong</strong>
      <p class="mb-0 mt-2"><%= error %></p>
    </div>
  </div>
<% } else { %>

<%
  // Officers and captains resolve to null where the league has not recorded one
  // (models/club.js). Rendering the card anyway produced an empty name and, worse,
  // `mailto:` / `tel:` links with nothing after the colon. `officerCard` is the one
  // place that decides what an unfilled role looks like.
  // Escaped by hand: this helper returns markup as a string, so it has to be emitted
  // with the raw-output tag, which by definition does not escape. Names, phone numbers
  // and email addresses all come straight out of the player table.
  function esc(v) {
    return String(v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
  function officerCard(role, name, tel, email) {
    var out = '<div class="official-card"><div class="official-role">' + esc(role) + '</div>';
    if (!name || !String(name).trim()) {
      return out + '<div class="official-name text-muted fst-italic">Not recorded</div></div>';
    }
    out += '<div class="official-name">' + esc(name) + '</div><div class="official-contacts">';
    if (tel) out += '<a href="tel:' + esc(tel) + '" class="contact-link">' + icon('phone') + ' ' + esc(tel) + '</a>';
    if (email) out += '<a href="mailto:' + esc(email) + '" class="contact-link">' + icon('envelope') + ' ' + esc(email) + '</a>';
    return out + '</div></div>';
  }
%>
<!-- Page Header -->
<section class="hero" style="padding: 4rem 2rem 3rem;">
  <h1><%- icon('shield-halved') %> Club Contact Information</h1>
  <p>Private contact details for league officials and team captains</p>
</section>

<!-- GDPR Warning -->
<section class="gdpr-warning">
  <div class="container">
    <div class="alert alert-warning alert-modern" role="alert">
      <div class="alert-icon">
        <%- icon('lock') %>
      </div>
      <div class="alert-content">
        <strong>Secure Area - Confidential Information</strong>
        <p class="mb-0 mt-2">
          This page contains personal information protected under GDPR. Access was approved by the Management Committee 
          to replace the physical handbook. All information is strictly confidential and for league use only.
        </p>
      </div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  </div>
</section>

<!-- Club Information -->
<section class="section">
  <div class="container">
    <div class="row g-4">
      <!-- Club Details Column -->
      <div class="col-lg-5">
        <div class="info-card-main">
          <div class="card-header-custom">
            <%- icon('building') %>
            <h2><%= clubrow[0].clubName %></h2>
          </div>
          
          <div class="info-section">
            <% if (!clubrow[0].venueId && !clubrow[0].matchVenueId) { %>
              <div class="info-block">
                <h3><%- icon('location-dot') %> Venue</h3>
                <p class="text-muted fst-italic mb-0">Not recorded</p>
              </div>
            <% } else if (clubrow[0].venueId == clubrow[0].matchVenueId) { %>
              <!-- Single Venue -->
              <div class="info-block">
                <h3><%- icon('location-dot') %> Venue</h3>
                <p class="venue-name"><%= clubrow[0].venueName %></p>
                <p class="venue-address"><%= clubrow[0].address %></p>
              </div>
            <% } else { %>
              <!-- Separate Match and Club Venues -->
              <div class="info-block">
                <h3><%- icon('trophy') %> Match Venue</h3>
                <p class="venue-name"><%= clubrow[0].matchVenueName %></p>
                <p class="venue-address"><%= clubrow[0].matchVenueAddress %></p>
              </div>
              
              <div class="info-block">
                <h3><%- icon('house') %> Club Venue</h3>
                <p class="venue-name"><%= clubrow[0].venueName %></p>
                <p class="venue-address"><%= clubrow[0].address %></p>
              </div>
            <% } %>
          </div>

          <!-- Officials Section -->
          <div class="officials-section">
            <h3><%- icon('user-tie') %> Club Officials</h3>
            
            <%- officerCard('Club Secretary', clubrow[0].clubSecretary, clubrow[0].clubSecTel, clubrow[0].clubSecEmail) %>
            <%- officerCard('Match Secretary', clubrow[0].matchSecretary, clubrow[0].matchSecTel, clubrow[0].matchSecEmail) %>
          </div>
        </div>
      </div>

      <!-- Teams Column -->
      <div class="col-lg-7">
        <div class="info-card-main">
          <div class="card-header-custom">
            <%- icon('users') %>
            <h2>Team Captains</h2>
          </div>
          
          <div class="teams-grid">
            <% clubrow.forEach(function(teamRow){ %>
              <div class="team-captain-card">
                <div class="team-header">
                  <span class="team-badge"><%- icon('shuttlecock') %></span>
                  <h4><%= teamRow.teamName %></h4>
                </div>
                <div class="captain-info">
                  <%- officerCard('Captain', teamRow.teamCaptain, teamRow.teamCaptainTel, teamRow.teamCaptainEmail) %>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<% } %>

<%- include('footer.ejs') %>

</body>
</html>