<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#6D8BB2">
<% /* Gated on app.locals.serviceWorkerEnabled — see the comment beside it in app.js.
      Defaults to registering if the local is somehow absent, so a stray render can
      never accidentally tear down the worker in production. */ %>
<% if (typeof serviceWorkerEnabled === 'undefined' || serviceWorkerEnabled) { %>
<script>
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/sw.js', { scope: '/' })
      .catch(function(err) { console.warn('SW registration failed:', err); });
  }
</script>
<% } else { %>
<script>
  // Not registering here (local dev). Also actively tear down anything a previous
  // session left behind — an already-installed worker would otherwise keep serving its
  // stale precached CSS/JS forever, since simply not registering does not remove it.
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.getRegistrations().then(function(regs) {
      regs.forEach(function(reg) { reg.unregister(); });
    }).catch(function() { /* nothing to unregister */ });
  }
  if (window.caches && caches.keys) {
    caches.keys().then(function(keys) {
      keys.forEach(function(key) {
        if (key.indexOf('tameside-static-') === 0) { caches.delete(key); }
      });
    }).catch(function() { /* no cache storage available */ });
  }
</script>
<% } %>
<script>
  (function() {
    var banner;
    function ensureBanner() {
      if (banner) { return banner; }
      banner = document.createElement('div');
      banner.textContent = "You're offline — showing a saved copy, some content may be out of date";
      banner.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:9999;' +
        'background:#6D8BB2;color:#fff;text-align:center;padding:6px 12px;' +
        'font:14px -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;display:none;';
      document.body.appendChild(banner);
      return banner;
    }
    function updateBanner() {
      ensureBanner().style.display = navigator.onLine ? 'none' : 'block';
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateBanner);
    } else {
      updateBanner();
    }
    window.addEventListener('online', updateBanner);
    window.addEventListener('offline', updateBanner);
  })();
</script>
