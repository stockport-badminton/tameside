<%- include('header.ejs') %>
<%- include('nav.ejs') %>

<%
  // Date helpers: dd/mm/yyyy for the event link (unchanged URL shape), and a short
  // "Sat 4 Oct" label for the compact lists.
  var DAYS = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  var MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  function ddmmyyyy(d){ return ('0' + d.getDate()).slice(-2) + '/' + ('0' + (d.getMonth()+1)).slice(-2) + '/' + d.getFullYear(); }
  function shortDate(d){ return DAYS[d.getDay()] + ' ' + d.getDate() + ' ' + MONTHS[d.getMonth()]; }
  var HOME_LIST_MAX = 8;
  var recentList = (typeof result !== 'undefined' ? result : []).slice().reverse().slice(0, HOME_LIST_MAX);
  var upcomingList = (typeof row !== 'undefined' ? row : []).slice(0, HOME_LIST_MAX);
  var newsList = (typeof announcements !== 'undefined' ? announcements : []);
%>

<div class="container home-body">
<%# No hero: the changing content is the first thing on the page. The h1 stays for
    search engines and screen readers; the navbar brand already says it visually. %>
<h1 class="visually-hidden">Tameside Badminton League</h1>

<% if (typeof scorecards !== 'undefined' && scorecards.length > 0) { %>
<!-- Outstanding Scorecards: a compact alert, not a full section -->
<section class="home-outstanding" data-ga-section="outstanding">
    <div class="home-head">
        <h2 class="section-title home-title">
            <i class="fas fa-triangle-exclamation"></i>
            <%= scorecards.length %> scorecard<%= scorecards.length === 1 ? '' : 's' %> outstanding
        </h2>
        <a href="/email-scorecard" class="btn-modern-primary home-enter">
            <i class="fas fa-pen-to-square"></i> Enter Result
        </a>
    </div>
    <ul class="home-chips">
        <% scorecards.forEach(function(sc){
            var d = new Date(sc['date']);
            var age = Date.now() - d;
            var level = age > 7*864e5 ? 'overdue' : age > 5*864e5 ? 'late' : '';
        %>
        <li class="home-chip <%= level %>">
            <span class="home-chip-date"><%= shortDate(d) %></span>
            <%= sc['homeTeam'] %> v <%= sc['awayTeam'] %>
        </li>
        <% }) %>
    </ul>
</section>
<% } %>

<div class="home-columns">
    <!-- Recent Results, newest first -->
    <section class="home-panel" data-ga-section="recent">
        <div class="home-head">
            <h2 class="section-title home-title"><i class="fas fa-list-check"></i> Recent Results</h2>
            <a class="home-more" href="/results/All">All results <i class="fas fa-arrow-right"></i></a>
        </div>
        <% if (recentList.length > 0) { %>
        <ul class="home-list">
            <% recentList.forEach(function(r){ var d = new Date(r['date']); %>
            <li>
                <span class="home-list-date"><%= shortDate(d) %></span>
                <span class="home-list-home"><%= r['homeTeam'] %></span>
                <span class="home-list-score"><%= r['homeScore'] %>&ndash;<%= r['awayScore'] %></span>
                <span class="home-list-away"><%= r['awayTeam'] %></span>
            </li>
            <% }) %>
        </ul>
        <% } else { %>
        <p class="home-empty">No results in the last 30 days.</p>
        <% } %>
    </section>

    <!-- Upcoming Fixtures -->
    <section class="home-panel" data-ga-section="upcoming">
        <div class="home-head">
            <h2 class="section-title home-title"><i class="fas fa-calendar-days"></i> Upcoming Fixtures</h2>
            <a class="home-more" href="/fixtures/All">All fixtures <i class="fas fa-arrow-right"></i></a>
        </div>
        <% if (upcomingList.length > 0) { %>
        <ul class="home-list">
            <% upcomingList.forEach(function(f){ var d = new Date(f['date']); var ds = ddmmyyyy(d); %>
            <li>
                <span class="home-list-date"><%= shortDate(d) %></span>
                <a class="home-list-fixture" href="<%= '/event/' + f.id + '/' + ds.replaceAll("/","") + '-' + f.homeTeam + '-' + f.awayTeam %>">
                    <%= f['homeTeam'] %> <span class="home-list-v">v</span> <%= f['awayTeam'] %>
                </a>
            </li>
            <% }) %>
        </ul>
        <% } else { %>
        <p class="home-empty">No upcoming fixtures scheduled.</p>
        <% } %>
    </section>
</div>

<% if (newsList.length > 0) { %>
<!-- News: headline and a two-line teaser; the full text is in the existing modal -->
<section class="home-news" data-ga-section="news">
    <h2 class="section-title home-title"><i class="fas fa-newspaper"></i> News</h2>
    <div class="home-news-grid">
        <% newsList.forEach(function(a){ %>
        <article class="home-news-item">
            <h3><%= a.title %></h3>
            <%# Clamp only when there is a modal to read the rest in; otherwise the teaser IS the whole announcement. %>
            <div class="home-news-teaser<%= a.modal_body_html ? ' clamped' : '' %>"><%- a.teaser_html %></div>
            <% if (a.modal_body_html) { %>
            <a href="#" data-bs-toggle="modal" data-bs-target="#announcementModal<%= a.id %>">Read more</a>
            <% } %>
        </article>
        <% }) %>
    </div>
</section>
<% } %>

</div>

<%- include('resultsEntryModal.ejs') %>
<% (typeof announcements !== 'undefined' ? announcements : []).forEach(function(a){ if (a.modal_body_html) { %>
<%- include('announcementModal.ejs', {a: a}) %>
<% } }) %>

<script>
  // How far down the homepage do people get? GA4's built-in scroll event only fires at
  // 90%, so this reports each section once per page view, the first time its heading is
  // fully on screen. Sections visible on load count too — that's the above-the-fold
  // baseline. Report on it via the event-scoped custom dimension `section` in GA admin.
  (function () {
    if (typeof gtag !== 'function' || !('IntersectionObserver' in window)) return;
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        observer.unobserve(entry.target);
        gtag('event', 'section_view', { section: entry.target.closest('[data-ga-section]').dataset.gaSection });
      });
    }, { threshold: 1.0 });
    document.querySelectorAll('[data-ga-section] .section-title').forEach(function (h) {
      observer.observe(h);
    });
  })();
</script>
<%- include('footer.ejs') %>