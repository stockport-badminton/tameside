<%- include('header.ejs') %>
<%- include('nav.ejs') %>

<% if (error) { %>
  <div class="container my-5">
    <div class="alert alert-danger" role="alert">
      <%- icon('triangle-exclamation') %> <strong>Something went wrong</strong>
      <p class="mb-0 mt-2"><%= error %></p>
    </div>
  </div>
<% } else { %>

<!-- Page Header -->
<section class="hero" style="padding: 4rem 2rem 3rem;">
  <h1><%- icon('users') %> Clubs</h1>
  <p>Find your local badminton club in the Tameside league</p>
</section>

<!-- Map Section -->
<section class="section" style="padding-top: 2rem;">
  <div class="container">
    <%
      // Tap to load. The map was 1.15MB in 34 requests of this page's 1.8MB, loaded the
      // moment the page opened, and its first tile was the page's LCP element — ~10s in
      // Lighthouse mobile, nearly all of it waiting on the Maps script (18 Oct 2026). 95% of
      // this page's visitors are on phones. Google Maps replaces everything inside #map
      // when it starts, so the placeholder needs no clean-up. Script: loadVenueMap below.
      var mappedVenues = venues.filter(function (v) { return v.Lat != null && v.Lng != null; }).length;
    %>
    <div id="map" class="map-placeholder" style="height: 400px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden; margin-bottom: 3rem;">
      <div class="map-placeholder-inner">
        <%- icon('map-location-dot', { class: 'map-placeholder-icon' }) %>
        <p class="map-placeholder-title">Where we play</p>
        <p class="map-placeholder-sub"><%= mappedVenues %> venue<%= mappedVenues === 1 ? '' : 's' %> around Tameside</p>
        <button type="button" id="showMap" class="btn-modern-primary"
                data-maps-src="https://maps.googleapis.com/maps/api/js?key=<%= mapsApiKey %>&libraries=marker&callback=initMap&loading=async">
          Show venues map
        </button>
      </div>
    </div>
  </div>
</section>

<!-- Clubs Grid -->
<section class="section" style="background: white; padding: 3rem 0;">
  <div class="container">
    <h2 class="section-title">
      <%- icon('building') %> Club Directory
    </h2>
    
    <div class="clubs-grid">
      <% result.forEach(function(row){ 
        if (row['id'] != 63) { %>
        
        <div class="club-card">
          <!-- Club Header -->
          <div class="club-header">
            <h3 class="club-name">
              <% if (row['clubWebsite'] != ''){ %>
                <a href="<%= row['clubWebsite'] %>" target="_blank">
                  <%= row['name'] %> <%- icon('arrow-up-right-from-square') %>
                </a>
              <% } else { %>
                <%= row['name'] %>
              <% } %>
            </h3>
          </div>

          <!-- Club Info Grid -->
          <div class="club-info">
            <!-- Contact -->
            <div class="info-item">
              <div class="info-label">
                <%- icon('envelope') %> Contact
              </div>
              <div class="info-content">
                <button type="button" class="btn-modern-primary btn-sm openForm" 
                        data-bs-toggle="modal" 
                        data-bs-target="#exampleModal" 
                        data-club="<%= row['id'] %>">
                  <%- icon('paper-plane') %> Get in touch
                </button>
                <div class="mt-2">
                  <a href="/club/<%= row['id'] %>" class="text-muted" style="font-size: 0.9rem;">
                    <%- icon('lock') %> Login for contact info
                  </a>
                </div>
              </div>
            </div>

            <!-- Match Details -->
            <div class="info-item">
              <div class="info-label">
                <%- icon('calendar') %> Match Details
              </div>
              <div class="info-content">
                <% if (row.teams.length > 1){ 
                  for (team of row.teams){ %>
                    <div class="team-info">
                      <strong><%= team.name %>:</strong><br />
                      <a href="<%= team.gMapURL %>" target="_blank" class="venue-link">
                        <%- icon('location-dot') %> <%= team.address %>
                      </a><br />
                      <span class="text-muted"><%= team.matchDay %></span>
                    </div>
                  <% } %>
                <% } else { %>
                  <div class="team-info">
                    <strong>All Teams:</strong><br />
                    <a href="<%= row.teams[0].gMapURL %>" target="_blank" class="venue-link">
                      <%- icon('location-dot') %> <%= row.teams[0].address %>
                    </a><br />
                    <span class="text-muted"><%= row.teams[0].matchDay %></span>
                  </div>
                <% } %>
              </div>
            </div>

            <!-- Club Night -->
            <div class="info-item">
              <div class="info-label">
                <%- icon('clock') %> Club Night
              </div>
              <div class="info-content">
                <%= row['clubNightText'] %>
              </div>
            </div>

            <!-- Main Venue -->
            <div class="info-item">
              <div class="info-label">
                <%- icon('location-dot') %> Main Venue
              </div>
              <div class="info-content">
                <a href="<%= row['gMapUrl'] %>" target="_blank" class="venue-link">
                  <%- icon('location-dot') %> <%= row['address'] %>
                </a>
              </div>
            </div>

            <!-- Admin Link (if applicable) -->
            <% if (typeof user !== 'undefined' && user['_json']['https://my-app.example.com/role'] == "superadmin") { %>
              <div class="info-item">
                <div class="info-label">
                  <%- icon('user-gear') %> Admin
                </div>
                <div class="info-content">
                  <a href="/manage-players/club-<%= encodeURIComponent(row['name']) %>" class="btn-modern-secondary btn-sm">
                    <%- icon('users-gear') %> Manage Players
                  </a>
                </div>
              </div>
            <% } %>
          </div>
        </div>
        
      <% }
      }) %>
    </div>
  </div>
</section>

<% } %>

<!-- Contact Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabel">
          <%- icon('envelope') %> Get in touch with 
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form role="form" id="contactUs" action="/contact-us" method="post">
        <div class="modal-body">
          <input type="hidden" value="" id="clubSelect" name="clubSelect" />
          <input type="hidden" value="Clubs" id="contactType" name="contactType" />

          <div class="mb-3">
            <label for="contactEmail" class="form-label">
              <%- icon('envelope') %> Email address
            </label>
            <input type="email" class="form-control" id="contactEmail" name="contactEmail" 
                   placeholder="your.email@example.com" required>
            <small class="form-text text-muted">We'll never share your email with anyone else.</small>
          </div>
          
          <div class="mb-3">
            <label for="contactQuery" class="form-label">
              <%- icon('message') %> Your message
            </label>
            <textarea class="form-control" id="contactQuery" name="contactQuery" 
                      rows="5" placeholder="Type your message here..." required></textarea>
          </div>
          
          <div class="mb-3">
            <div class="g-recaptcha" data-sitekey="<%= recaptcha %>"></div>
          </div>
        </div>
        
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <%- icon('xmark') %> Close
          </button>
          <button type="submit" class="btn-modern-primary">
            <%- icon('paper-plane') %> Send Message
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('footer.ejs') %>

<!-- The popup builder is a file, not an inline block, so it can be unit-tested.
     See static/js/venue-popup.js and test/venue-popup.test.js. -->
<script src="<%= assetUrl('/static/js/venue-popup.js') %>"></script>
<script>
// The venue map.
//
// The pin content comes from VenuePopup (static/js/venue-popup.js), which is where the
// escaping lives and where the decision about WHICH of a club's two venues is being shown
// is made. This block is now only about Google Maps.
function initMap() {
  var StockportTownHall = {lat: 53.4060787, lng: -2.1606755};
  var map = new google.maps.Map(
    document.getElementById('map'),
    {
      zoom: 10,
      center: StockportTownHall,
      mapId: '28eeb908f19e8aab'
    }
  );

  // `jsonForScript`, not `JSON.stringify`: a venue address is free text, and one
  // containing a closing script tag would otherwise end this block early — the browser
  // finds the end of a script element before any JS is parsed. See utils/jsonForScript.js.
  //
  // (Writing that tag literally here, even inside a comment, does exactly the same thing.
  // It did, on the first attempt at this file: the block ended mid-comment, initMap was
  // never defined, and the Maps callback reported `initMap is not a function`.)
  var data = <%- jsonForScript(venues) %>;

  // ONE InfoWindow, reused. Google's own guidance, and the previous code created a new one
  // per marker — so clicking three pins left three popups open on top of each other.
  var infowindow = new google.maps.InfoWindow();

  data.forEach(function (venue) {
    // A venue with no coordinates cannot be placed. "No Venue" is a real row in this
    // table, which is why this guard exists.
    if (venue.Lat == null || venue.Lng == null) return;

    var clubMarker = new google.maps.marker.AdvancedMarkerElement({
      position: {lat: venue.Lat, lng: venue.Lng},
      map: map,
      gmpClickable: true
    });

    // AdvancedMarkerElement emits 'gmp-click', not 'click' — using 'click'
    // logs a deprecation warning (gmpClickable must be true for it to fire).
    clubMarker.addListener('gmp-click', function () {
      infowindow.setContent(VenuePopup.popupHtml(venue));
      infowindow.open(map, clubMarker);
    });
  });
}
</script>

<script>
// The Maps script is fetched only when someone asks for the map (see the note on #map).
// Once only: a second tap while it loads does nothing. If the script fails, the button
// says so and can be tapped again.
(function () {
  var btn = document.getElementById('showMap');
  if (!btn) { return; }
  btn.addEventListener('click', function () {
    if (btn.disabled) { return; }
    btn.disabled = true;
    btn.textContent = 'Loading map…';
    var s = document.createElement('script');
    s.src = btn.getAttribute('data-maps-src');
    s.async = true;
    s.onerror = function () {
      s.remove();
      btn.disabled = false;
      btn.textContent = "Couldn't load the map. Try again";
    };
    document.head.appendChild(s);
  });
})();
</script>
<script src="//www.google.com/recaptcha/api.js" async defer></script>

<script type="text/javascript">
  // Plain JS: this page loads no jQuery (footer.ejs, useJQuery). Delegated, so a button
  // added after load is covered too. The club name goes in as text, not HTML.
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.openForm');
    if (!btn) { return; }
    var clubName = btn.getAttribute('data-club') || '';
    var label = document.getElementById('exampleModalLabel');
    label.innerHTML = '<%- icon('envelope') %> ';
    label.appendChild(document.createTextNode('Get in touch with ' + clubName));
    document.getElementById('clubSelect').value = clubName;
  });
</script>

</body>
</html>