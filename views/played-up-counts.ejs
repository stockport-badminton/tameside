<%- include('header.ejs', { useDataTables: true }) %>
<%- include('nav.ejs') %>


  <% if (typeof errors !== 'undefined') { %>
    <p>Something seems to have gone wrong</p>
    <p><%= error %></p>
  <% }
  else { %>
    <h1>Registered Players</h1>
    <div class="dt-table-shell">
    <table class="table" id="results-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>teamName</th>
          <th>playedUp</th>
          <th>playedOwnTeam</th>
        </tr>
      </thead>
      <tbody>
    <% result.forEach(function(row){ %>
      <tr>

          <td><a href="/sendPlayerReminder/<%= row['playerId'] %>"><%= row['firstName'] %> <%= row['familyName'] %> </a></td>
          <td><%= row['teamName'] %></td>
          <td><%= row['playedUp'] %></td>
          <td><%= row['playedOwnTeam'] %></td>
      </tr>
    <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
        </tr>
      </tfoot>
    </table>
  </div>
   <% } %>




<%- include('footer.ejs') %>
<%- include('datatables-stats.ejs', { dtColumnSearch: true }) %>

</body>
</html>
