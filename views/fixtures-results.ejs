<%- include('header.ejs', { useDataTables: true }) %>
<%- include('nav.ejs') %>

<% if (error) { %>
  <div class="container my-5">
    <div class="alert alert-danger" role="alert">
      <%- icon('triangle-exclamation') %> <strong>Something went wrong</strong>
      <p class="mb-0 mt-2"><%= error %></p>
    </div>
  </div>
<% } else { %>

<!-- Page Header with Actions -->
<section class="results-header">
  <div class="container">
    <div class="results-header-content">
      <h1><%- icon('trophy') %> <%= division %></h1>
      <div class="header-actions">
        <a class="action-btn" href="<%= path.replace('\/results\/','\/results-grid\/') %>" 
           title="Switch to grid view">
          <%- icon('table-cells', { class: 'icon-float' }) %>
          <span>Grid View</span>
        </a>
        <a class="action-btn" href="<%= path.replace('\/results\/','\/calendars\/') %>" 
           title="Download calendar">
          <%- icon('calendar', { class: 'icon-float' }) %>
          <span>Calendar</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Admin Info (if applicable) -->
<% if (typeof admin !== 'undefined') { %>
<section class="admin-info">
  <div class="container">
    <div class="info-card">
      <%- icon('user-shield') %>
      <div>
        <strong>Welcome, <%= user.nickname %></strong><br />
        <span class="text-muted">
          Club: <%= user._json["https://my-app.example.com/club"] %> | 
          Role: <%= user._json["https://my-app.example.com/role"] %>
        </span>
      </div>
    </div>
  </div>
</section>
<% } %>

<!-- Filters. Rendered inline like every other filtered page: the toolbar is one
     row, so it no longer needs the show/hide section (and its #showFilter button)
     that used to hide it by default here and nowhere else. -->
<% if (typeof filter !== 'undefined' && filter == true){ %>
<section class="filters-section">
  <div class="container">
    <%- include('filters.ejs') %>
  </div>
</section>
<% } %>

<!-- Results Table -->
<section class="results-section">
  <div class="container">
    <div class="table-container">
      <table class="table modern-table" id="results-table">
        <thead>
          <tr>
            <th><%- icon('calendar', { variant: 'regular' }) %> Date</th>
            <th><%- icon('house') %> Home Team</th>
            <th><%- icon('plane-departure') %> Away Team</th>
            <th><%- icon('trophy') %> Result</th>
            <% if (typeof admin !== 'undefined') { %>
              <th><%- icon('circle-info') %> Details</th>
            <% } %>
            <% if (typeof superadmin !== 'undefined' && superadmin) { %>
              <th><%- icon('calendar-days') %> Rearrange</th>
              <th><%- icon('pen-to-square') %> Action</th>
            <% } %>
          </tr>
        </thead>
        <tbody>
          <% var tournamentReminder = false %>
          <% var tournament2Reminder = false %>
          <% result.forEach(function(row){ %>
            <%
              var rowClass = '';
              var resultValue = '';
              var status = ""
              var MyDate = new Date(row['date']);
              var lewisLabels = {1: 'LS Prelim', 2: 'LS R1', 3: 'LS QF'};
              var lewisClasses = {1: 'lewis-prelim', 2: 'lewis-r1', 3: 'lewis-qf'};
              var NowDate = Date.now();
              if ((MyDate < NowDate) && (row['homeScore'] == null) && (row['status'] != 'void')) {
                rowClass = 'status-overdue'
                var resultValue = 'Awaiting Result';
              }
              var MyDateString = ('0' + MyDate.getDate()).slice(-2) + '/'
                               + ('0' + (MyDate.getMonth()+1)).slice(-2) + '/'
                               + MyDate.getFullYear();
            %>

            <% if (row['status'] == 'rearranging'){
              var rowClass = 'status-rearranging';
              var resultValue = 'Rearranging';
              var status = ""
             }
             %>

             <% if (row['homeTeam'].indexOf('Tournament') > -1 || row['homeTeam'].indexOf('Messer') > -1 ){
               var rowClass = 'status-tournament';
               var status = ""
              }
              %>
             <% if (row['status'] == 'rearranged'){
              var rowClass = 'status-rearranged';
              var resultValue = 'Rearranged';
              var status = ""
             }
             %>

             <% if (row['status'] == 'conceded'){
              var rowClass = 'status-conceded';
              var resultValue = 'Conceded';
              var status = "Conceded"
             }
             %>

             <% if (row['status'] == 'void'){
               var rowClass = 'status-void';
               var resultValue = "Void"
               var status = "Void"
              }
              %>

            <tr class="<%= rowClass %>">
              <% if (typeof superadmin !== 'undefined' && superadmin) {
                   var MyDateISO = MyDate.getFullYear() + '-'
                                 + ('0' + (MyDate.getMonth()+1)).slice(-2) + '-'
                                 + ('0' + MyDate.getDate()).slice(-2); %>
              <td class="date-cell" data-fixture-id="<%= row['id'] %>" data-date-iso="<%= MyDateISO %>">
                <span class="date-display"><%= MyDateString %></span>
                <button type="button" class="btn btn-sm btn-link p-0 ms-1 date-edit-btn" title="Edit date"><%- icon('pencil') %></button>
              </td>
              <% } else { %>
              <td class="date-cell"><%= MyDateString %></td>
              <% } %>
              <td data-hometeam="<%= row['homeClubId'] %>">
                <a href="<%= row['venuelink'] %>" target="_blank" class="venue-icon" title="View venue">
                  <%- icon('map-location-dot') %>
                </a>
                <span class="team-name"><%= row['homeTeam'] %></span>
              </td>
              <td data-awayteam="<%= row['awayteamId'] %>">
                <span class="team-name"><%= row['awayTeam'] %></span>
              </td>
              <% if(row['homeScore'] != null){ %>
                <td class="result-cell">
                  <span class="score"><%= row['homeScore'] %> - <%= row['awayScore'] %></span>
                  <% if(status){ %>
                    <span class="status-badge"><%= status %></span>
                  <% } %>
                  <% if(row['lewis_round']){ %>
                    <span class="status-badge <%= lewisClasses[row['lewis_round']] %>"><%= lewisLabels[row['lewis_round']] %></span>
                  <% } %>
                  <%# Gated on a real division name as well as the role: the card's
                      background is picked by division, so there is no image for "All". %>
                  <% if (typeof superadmin !== 'undefined' && superadmin && division && division !== 'All') { %>
                    <br />
                    <%# Built through the helper, not interpolated. Every team name in this
                        league contains a space and a raw space is not a legal URL character —
                        that is what had Facebook answering "Missing or invalid image file
                        (324, OAuthException)" for a route that was fine the whole time.

                        The keys were `hometeam`/`awayteam` and `row['divisionName']`, none of
                        which exist on these rows — so this link has been emitting
                        `/resultImage////` for its whole life. Nobody noticed because only a
                        superadmin sees it. %>
                    <a href="<%= resultImagePath({ homeTeam: row['homeTeam'], awayTeam: row['awayTeam'], homeScore: row['homeScore'], awayScore: row['awayScore'], division: division }) %>" 
                       class="social-link">
                      <%- icon('image') %> Social Image
                    </a>
                  <% } %>
                </td>
                <% if (typeof admin !== 'undefined') { %>
                  <td>
                    <a href="/scorecard/fixture/<%= row['id'] %>" class="details-link">
                      <%- icon('file-lines') %> Details
                    </a>
                  </td>
                <% } %>
              <% } else { %>
                <td class="result-cell">
                  <span class="status-badge status-pending"><%= resultValue %></span>
                  <% if(row['lewis_round']){ %>
                    <span class="status-badge <%= lewisClasses[row['lewis_round']] %>"><%= lewisLabels[row['lewis_round']] %></span>
                  <% } %>
                </td>
                <% if (typeof admin !== 'undefined') { %>
                  <td></td>
                <% } %>
              <% } %>
              
              <% if (typeof superadmin !== 'undefined' && superadmin) { %>
                <td>
                  <% if (row['status'] === 'outstanding' || row['status'] === 'rearranged' || row['status'] === 'rearranging') { %>
                    <a data-bs-toggle="modal" 
                       data-bs-target="#exampleModal" 
                       data-club="<%= row['name'] %>" 
                       data-fixtureId="<%= row['id'] %>"
                       class="action-link">
                      <%- icon('calendar-days') %> Rearrange
                    </a> 
                    <% if(resultValue === 'Awaiting Result'){ %>
                      <br />
                      <a data-bs-toggle="modal" 
                         data-bs-target="#reminderModal"
                         class="action-link">
                        <%- icon('bell') %> Send Reminder
                      </a>
                    <% } %>
                  <% } %>
                  <%# Mirrors Fixture.CONCEDABLE — and not 'rearranged', which is the
                      superseded original of a rearranged match. The server enforces it too. %>
                  <% if ((row['status'] === 'outstanding' || row['status'] === 'rearranging') && row['homeScore'] == null) { %>
                    <br />
                    <a href="#" class="action-link concede-link"
                       data-fixture-id="<%= row['id'] %>"
                       data-home="<%= row['homeTeam'] %>"
                       data-away="<%= row['awayTeam'] %>">
                      <%- icon('flag') %> Concede
                    </a>
                  <% } else if (row['status'] === 'conceded') { %>
                    <a href="#" class="action-link concede-undo-link" data-fixture-id="<%= row['id'] %>">
                      <%- icon('rotate-left') %> Undo concession
                    </a>
                  <% } %>
                </td>
                
                <% if (user._json["https://my-app.example.com/club"] == 'All' || user._json["https://my-app.example.com/club"] == row['homeClubName']){ %>
                  <td>
                    <a href="/fixtures/edit/<%= row['id'] %>" class="btn-modern-primary btn-sm">
                      <%- icon('pen') %> Enter
                    </a>
                  </td> 
                <% } else { %>
                  <td>
                    <a href="/fixtures/edit/<%= row['id'] %>" class="btn-modern-secondary btn-sm">
                      <%- icon('check') %> Confirm
                    </a>
                  </td> 
                <% } %>
              <% } %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<% } %>

<!-- Rearrangement Modal -->
<% if (typeof superadmin !== 'undefined' && superadmin) { %>
<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <%- icon('calendar-days') %> Rearrange Fixture
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form role="form" id="contactUs" action="/fixture/rearrangement" method="post">
        <div class="modal-body" id="rearrangementModal">
          <div class="formMessage" style="display:none">
            <div class="alert alert-success">
              <%- icon('circle-check') %> Fixture Updated!
            </div>
          </div>
          <div id="rearrangementForm" class="form-group">
            <label for="date">
              <%- icon('calendar', { variant: 'regular' }) %> New Fixture Date
            </label>
            <input type="date" class="form-control" id="date" name="date">
            <small class="form-text text-muted">Leave blank if date not yet confirmed.</small>
            <input type="hidden" name="fixtureId" id="fixtureId" value="" />
            <input type="hidden" name="hometeam" id="hometeam" value="" />
            <input type="hidden" name="awayteam" id="awayteam" value="" />
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <%- icon('xmark') %> Close
          </button>
          <button type="button" id="fixtureRearange" class="btn-modern-primary">
            <%- icon('check') %> Submit
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Concede Modal -->
<div class="modal fade" id="concedeModal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <%- icon('flag') %> Concede Fixture
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p>Which team conceded? The other team is awarded the match 18-0.</p>
        <div class="d-grid gap-2">
          <button type="button" class="btn btn-outline-danger concede-side" data-side="home"></button>
          <button type="button" class="btn btn-outline-danger concede-side" data-side="away"></button>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
          <%- icon('xmark') %> Cancel
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Reminder Modal -->
<div class="modal fade" id="reminderModal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <%- icon('bell') %> Send Reminder
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form role="form" id="reminderForm" action="/fixture/reminder" method="post">
        <div class="modal-body" id="reminderModalBody">
          <div class="form-group">
            <label for="email">
              <%- icon('envelope') %> Email Contact
            </label>
            <input type="email" class="form-control" id="email" name="email" 
                   placeholder="captain@example.com">
            <input type="hidden" name="reminderhometeam" id="reminderhometeam" value="" />
            <input type="hidden" name="reminderawayteam" id="reminderawayteam" value="" />
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <%- icon('xmark') %> Close
          </button>
          <button type="button" id="remindFixture" class="btn-modern-primary">
            <%- icon('paper-plane') %> Send
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>

<%- include('footer.ejs', { useJQuery: true }) %>
<%- include('datatables.ejs') %>

<% if (typeof filter !== 'undefined' && filter == true){ %>
<script type="text/javascript">
  <%- include('filtersJs.ejs') %>
</script>
<% } %>

<% if (typeof superadmin !== 'undefined' && superadmin) { %>
<script type="text/javascript">
  // Inline fixture-date editing: click the pencil to edit a fixture's date in
  // place (distinct from Rearrange, which archives + re-inserts). POSTs to
  // /admin/fixture/:id/date; the cell updates on success.
  $(document).on('click', '.date-edit-btn', function () {
    var $cell = $(this).closest('.date-cell');
    if ($cell.find('input.date-input').length) return; // already editing
    var iso = $cell.attr('data-date-iso');
    $cell.find('.date-display, .date-edit-btn').hide();
    $('<input type="date" class="date-input form-control form-control-sm d-inline-block" style="width:auto">')
      .val(iso).appendTo($cell).focus();
  });

  function saveDate($cell) {
    var $input = $cell.find('input.date-input');
    var newDate = $input.val();
    var id = $cell.attr('data-fixture-id');
    if (!newDate) { cancelEdit($cell); return; }
    $input.prop('disabled', true);
    $.post('/admin/fixture/' + id + '/date', { date: newDate })
      .done(function () {
        var d = newDate.split('-'); // YYYY-MM-DD -> DD/MM/YYYY
        $cell.attr('data-date-iso', newDate);
        $cell.find('.date-display').text(d[2] + '/' + d[1] + '/' + d[0]);
        cancelEdit($cell);
      })
      .fail(function (xhr) {
        alert('Could not update date: ' + ((xhr.responseJSON && xhr.responseJSON.error) || xhr.statusText));
        $input.prop('disabled', false);
      });
  }

  function cancelEdit($cell) {
    $cell.find('input.date-input').remove();
    $cell.find('.date-display, .date-edit-btn').show();
  }

  $(document).on('keydown', 'input.date-input', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); saveDate($(this).closest('.date-cell')); }
    else if (e.key === 'Escape') { cancelEdit($(this).closest('.date-cell')); }
  });
  $(document).on('blur', 'input.date-input', function () { saveDate($(this).closest('.date-cell')); });

  // Conceding: POSTs to /admin/fixture/:id/concede and reloads, because the row's
  // class, result cell and actions all change with the status.
  function postConcede(id, concededBy) {
    return $.post('/admin/fixture/' + id + '/concede', { concededBy: concededBy })
      .done(function () { location.reload(); })
      .fail(function (xhr) {
        alert('Could not update fixture: ' + ((xhr.responseJSON && xhr.responseJSON.error) || xhr.statusText));
      });
  }

  var concedeFixtureId = null;
  $(document).on('click', '.concede-link', function (e) {
    e.preventDefault();
    concedeFixtureId = $(this).attr('data-fixture-id');
    // .text(), never .html(): team names go in as text.
    $('#concedeModal .concede-side[data-side="home"]').text($(this).attr('data-home') + ' conceded').prop('disabled', false);
    $('#concedeModal .concede-side[data-side="away"]').text($(this).attr('data-away') + ' conceded').prop('disabled', false);
    bootstrap.Modal.getOrCreateInstance(document.getElementById('concedeModal')).show();
  });
  $('#concedeModal .concede-side').on('click', function () {
    $('#concedeModal .concede-side').prop('disabled', true);
    postConcede(concedeFixtureId, $(this).attr('data-side'))
      .fail(function () { $('#concedeModal .concede-side').prop('disabled', false); });
  });
  $(document).on('click', '.concede-undo-link', function (e) {
    e.preventDefault();
    if (confirm('Undo this concession? The fixture goes back to outstanding with no score.')) {
      postConcede($(this).attr('data-fixture-id'), 'none');
    }
  });

  $('a[data-bs-target="#exampleModal"]').click(function(){
    $('#rearrangementModal > .formMessage').hide();
    $('#rearrangementForm > #date').show()
    $('#rearrangementForm > label').show()
    $('#fixtureRearange').show();
    $('#emailHelp').show()
    $('#rearrangementForm > #date')[0].value = "";
    $('#fixtureId')[0].value = $(this)[0]['attributes']['data-fixtureId'].value;
    $('#hometeam')[0].value = $(this).parent().siblings()[1].innerText.trim();
    $('#awayteam')[0].value = $(this).parent().siblings()[2].innerText.trim();
  })

  $('a[data-bs-target="#reminderModal"]').click(function(){
    $('#reminderhometeam')[0].value = $(this).parent().siblings()[1].innerText.trim();
    $('#reminderawayteam')[0].value = $(this).parent().siblings()[2].innerText.trim();
    var hometeamId = this.parentElement.parentElement.children[1].getAttribute('data-hometeam').valueOf()
    var hometeamName = this.parentElement.parentElement.children[1].innerText.trim()
    $.get('/club-api/'+hometeamId, function(data){ 
      var filterTeams = data.filter(row => row.teamName == hometeamName)
      let emails = filterTeams.map(row => row.teamCaptainEmail)
      $('#reminderModalBody > div.form-group > input#email')[0].value = filterTeams[0].matchSecEmail + "," + emails.join(",")
    })
  })

  $('#fixtureRearange').click(function(){
    $.post('/fixture/rearrangement', {
      'date':$('#date')[0].value,
      'hometeam':$('#hometeam')[0].value,
      'awayteam':$('#awayteam')[0].value 
    }, function (data) {
      $('#rearrangementModal > .formMessage').show();
      $('#rearrangementForm > label').hide()
      $('#rearrangementForm > #date').hide()
      $('#emailHelp').hide()
      $('#fixtureRearange').hide();
    });
  })

  $('#remindFixture').click(function(){
    $.post('/fixture/reminder', {
      'email':$('#email')[0].value,
      'hometeam':$('#reminderhometeam')[0].value,
      'awayteam':$('#reminderawayteam')[0].value 
    }, function (data) {
      $('#reminderModalBody').html('<div class="alert alert-success"><%- icon('circle-check') %> Reminder sent!</div>');
      $('#remindFixture').remove();
    }).fail(function (xhr) {
      // A 400 names what to fix (a mistyped address, or more than ten of them).
      $('#reminderModalBody .alert').remove();
      $('#reminderModalBody').append($('<div class="alert alert-danger mt-2">').text(xhr.responseText || 'Reminder not sent.'));
    });
  })
</script>
<% } %>

</body>
</html>