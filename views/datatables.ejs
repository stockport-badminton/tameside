<!-- Results/fixture tables: date-sorted on column 0 and paged to the nearest date.
     Stats tables use datatables-stats.ejs instead. -->
<%- include('datatables-scripts.ejs') %>
<script type="text/javascript" src="//cdn.datatables.net/plug-ins/1.12.0/api/page.jumpToData().js"></script>

<script type="text/javascript">
  $(document).ready( function () {
      var table = $('#results-table').DataTable( {
        "columnDefs": [
          { "type": "date-euro", "targets": 0 }
        ],
        pageLength:20,
        <%- include('datatables-controls.ejs') %>
        buttons: [
          { extend: 'colvis', className: 'dt-btn' }
        ]
      });
      <%
      if (typeof nearestDate === 'undefined'){
        nearestDate = new Date()
      }
      %>
      var today = new Date("<%= nearestDate %>")
      currentDateString = ('0' + today.getDate()).slice(-2) + '/'
             + ('0' + (today.getMonth()+1)).slice(-2) + '/'
             + today.getFullYear();
      table.page.jumpToData(currentDateString, 0 );
      
  } );
</script>
